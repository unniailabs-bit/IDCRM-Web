# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Environment variables & secrets (prevent committing keys or credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.pem
*.key
serviceAccountKey.json
config/serviceAccountKey.json

# User uploads / dynamic media directories (contains generated/uploaded files)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test / Coverage
coverage/
.nyc_output/

# Build / cache
dist/
build/
.cache/
tmp/
*.tmp

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
