# Copy this file to .env and fill in your local values.
# Never commit .env - it contains secrets.

# Database
DB_NAME=SchoolAppV2
DB_USER=postgres
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Server
PORT=5001
NODE_ENV=development

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# URLs (use your machine IP or localhost for local dev)
FRONTEND_URL=http://localhost:3000
MAIN_BACKEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5001

# Where uploaded media is served from (usually the main backend URL)
MEDIA_STORAGE_URL=http://localhost:5000

# Optional: path to main backend uploads folder when running locally
# IDCRM_UPLOADS_PATH=../backend/uploads

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=your_sender@example.com
BREVO_SENDER_NAME=Shikshalaya